# ===== העתיקו קובץ זה ל־.env ומלאו ערכים אמיתיים. אל תעלו את .env ל־GitHub! =====

# סביבת הריצה: development / production / test
NODE_ENV=development

# הפורט של השרת. בענן (Render) הפורט נקבע אוטומטית
PORT=3000

# כתובת החיבור ל־PostgreSQL
# מקומי:  postgresql://USER:PASSWORD@localhost:5432/hatzad_dev
# Neon:   postgresql://USER:PASSWORD@ep-xxxx.eu-central-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/hatzad_dev"

# מפתח סודי לחתימת JWT — לפחות 32 תווים אקראיים. ליצירה:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="change-me-to-a-long-random-secret-at-least-32-chars"

# תוקף ה־Token: למשל 30m, 8h, 7d
JWT_EXPIRES_IN=8h

# כתובות האתר של צד הלקוח (React) שמורשות לפנות לשרת, מופרדות בפסיקים
# Vite מקומי: http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# המנהל הראשי — נוצר ב־Seed רק אם עדיין אין מנהל ראשי
SUPER_ADMIN_EMAIL=super@example.com
SUPER_ADMIN_PASSWORD=ChangeMe12345
SUPER_ADMIN_NAME=מנהל ראשי

# נתוני הדגמה (מוסדות, מנהלים, תלמידים ומועמדויות לדוגמה)
# בפיתוח: נוצרים כברירת מחדל, עם הסיסמאות Admin1234! ו־Student1234!
# ב־Production: רק אם SEED_DEMO_DATA=true, ואז חובה DEMO_PASSWORD (סיסמה אחת לכל חשבונות ההדגמה)
SEED_DEMO_DATA=true
DEMO_PASSWORD=

# אזור הזמן לחישוב "היום" במסך הבית
APP_TIMEZONE=Asia/Jerusalem

# מספר סבבי bcrypt (10 מתאים לרוב המקרים)
BCRYPT_ROUNDS=10

# לבדיקות האוטומטיות: מסד נתונים נפרד שכל הנתונים בו נמחקים! השם חייב להכיל test
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/hatzad_test"
